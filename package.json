{
  "name": "codex-mobile-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n gateway,mobile -c cyan,green \"npm:dev:gateway\" \"npm:dev:mobile\"",
    "dev:lan": "concurrently -n gateway,mobile -c cyan,green \"npm:dev:gateway:lan\" \"npm:dev:mobile:lan\"",
    "dev:gateway": "tsx watch server/src/index.ts",
    "dev:gateway:lan": "CMC_HOST=0.0.0.0 tsx watch server/src/index.ts",
    "dev:mobile": "vite --config mobile/vite.config.ts --host 127.0.0.1",
    "dev:mobile:lan": "vite --config mobile/vite.config.ts --host 0.0.0.0",
    "build": "npm run build:server && npm run build:mobile",
    "build:server": "tsc -p tsconfig.server.json",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "start": "node dist/server/index.js",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "check": "npm run build"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
