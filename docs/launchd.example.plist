<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zylen.codex-mobile-console</string>

  <key>WorkingDirectory</key>
  <string>/path/to/codex-mobile-console</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>dev:gateway:lan</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/codex-mobile-console.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/codex-mobile-console.err.log</string>
</dict>
</plist>
